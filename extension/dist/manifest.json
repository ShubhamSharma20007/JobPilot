{
  "manifest_version": 3,
  "name": "JobPilot – Add to Sheet",
  "version": "1.0.0",
  "description": "Select any email on any page and add it instantly to your JobPilot recruiter sheet.",
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "cookies",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
 
  "host_permissions": [
    "http://localhost:8001/*",
    "https://*.jobpilot.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {

    "default_title": "JobPilot"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
